---
const { app, lang = 'en' } = Astro.props;
const uk = lang === 'uk';
const t = (en, ua) => uk ? ua : en;
const slides = app === 'pns' ? [
  { src: '/showcase/pns/generation.png', title: t('Generate a model', 'Згенеруйте модель'), text: t('Describe a system in the chat and receive a Petri net.', 'Опишіть систему в чаті та отримайте мережу Петрі.') },
  { src: '/upstream/web/docs/assets/editor.png', title: t('Edit the net', 'Редагуйте мережу'), text: t('Change places, transitions, arcs and timing parameters.', 'Змінюйте позиції, переходи, дуги та часові параметри.') },
  { src: '/showcase/pns/simulation.png', title: t('Run a simulation', 'Запустіть симуляцію'), text: t('Follow token markings and active transitions during a run.', 'Стежте за маркуванням і активними переходами під час симуляції.') },
  { src: '/upstream/web/docs/assets/statistics.png', title: t('Inspect statistics', 'Аналізуйте статистику'), text: t('Read place and transition charts, then export the results.', 'Переглядайте графіки позицій і переходів та експортуйте результати.') },
  { src: '/upstream/web/docs/assets/petri-objects.png', title: t('Compose Petri-object models', 'Поєднуйте Петрі-об’єкти'), text: t('Build a larger system from linked reusable nets.', 'Будуйте складні системи зі з’єднаних мереж.') }
] : [
  { src: '/showcase/pomp/editor.png', title: t('Build a Petri net', 'Побудуйте мережу Петрі'), text: t('Work with places, transitions and timing on the desktop canvas.', 'Працюйте з позиціями, переходами та часом у настільному редакторі.') },
  { src: '/showcase/pomp/simulation.png', title: t('Follow the simulation', 'Спостерігайте за симуляцією'), text: t('Inspect token markings and active transitions as the model runs.', 'Стежте за маркуванням позицій і активними переходами.') },
  { src: '/showcase/pomp/objects.png', title: t('Connect Petri-objects', 'З’єднуйте Петрі-об’єкти'), text: t('Compose a model from separate linked objects.', 'Створюйте модель з окремих пов’язаних об’єктів.') }
];
---
<app-showcase data-app={app} data-lang={lang} role="region" aria-roledescription={t('slideshow', 'слайд-шоу')} aria-label={app === 'pns' ? 'Petri Net Sim' : 'PetriObjModelPaint'}>
  <div class="slides">{slides.map((slide, index) => <figure hidden={index !== 0} data-slide>
    <a href={slide.src} target="_blank" rel="noopener" title={t('Open full-size screenshot', 'Відкрити зображення в повному розмірі')}><img src={slide.src} alt={`${slide.title}. ${slide.text}`} loading="lazy" width="1200" height="650"/><span class="expand" aria-hidden="true">↗</span></a>
    <figcaption><strong>{slide.title}</strong><span>{slide.text}</span></figcaption>
  </figure>)}</div>
  <div class="controls"><button type="button" data-prev aria-label={t('Previous slide', 'Попередній слайд')}>←</button><div class="dots" role="group" aria-label={t('Choose slide', 'Обрати слайд')}>{slides.map((slide, index) => <button type="button" data-index={index} aria-label={slide.title} aria-pressed={index === 0}><span></span></button>)}</div><button type="button" data-next aria-label={t('Next slide', 'Наступний слайд')}>→</button><button type="button" class="pause" data-pause aria-label={t('Pause slideshow', 'Призупинити слайд-шоу')}>Ⅱ</button><span class="counter" aria-live="off" data-counter>1 / {slides.length}</span></div>
</app-showcase>
<script>
class AppShowcase extends HTMLElement {
  private cleanup?: () => void;
  connectedCallback() {
    const slides = [...this.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...this.querySelectorAll<HTMLButtonElement>('[data-index]')];
    const pause = this.querySelector<HTMLButtonElement>('[data-pause]')!;
    const counter = this.querySelector<HTMLElement>('[data-counter]')!;
    const media = matchMedia('(prefers-reduced-motion: reduce)');
    let index = 0, paused = media.matches, hovering = false, focused = false, visible = false;
    const uk = this.dataset.lang === 'uk';
    const render = (next: number) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, n) => slide.hidden = n !== index);
      dots.forEach((dot, n) => dot.setAttribute('aria-pressed', String(n === index)));
      counter.textContent = `${index + 1} / ${slides.length}`;
    };
    const updatePause = () => {
      pause.textContent = paused ? '▶' : 'Ⅱ';
      pause.setAttribute('aria-label', paused ? (uk ? 'Продовжити слайд-шоу' : 'Play slideshow') : (uk ? 'Призупинити слайд-шоу' : 'Pause slideshow'));
    };
    const manual = (next: number) => { render(next); paused = true; updatePause(); };
    this.querySelector('[data-prev]')!.addEventListener('click', () => manual(index - 1));
    this.querySelector('[data-next]')!.addEventListener('click', () => manual(index + 1));
    dots.forEach((dot, n) => dot.addEventListener('click', () => manual(n)));
    pause.addEventListener('click', () => { paused = !paused; updatePause(); });
    this.addEventListener('mouseenter', () => hovering = true);
    this.addEventListener('mouseleave', () => hovering = false);
    this.addEventListener('focusin', () => focused = true);
    this.addEventListener('focusout', () => focused = this.contains(document.activeElement));
    this.addEventListener('keydown', event => { if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') { event.preventDefault(); manual(index + (event.key === 'ArrowRight' ? 1 : -1)); } });
    const observer = new IntersectionObserver(entries => visible = entries[0].isIntersecting, { threshold: 0.25 });
    observer.observe(this);
    const onMotion = () => { if (media.matches) { paused = true; updatePause(); } };
    media.addEventListener('change', onMotion);
    const timer = window.setInterval(() => { if (!paused && !hovering && !focused && visible && !document.hidden) render(index + 1); }, 6000);
    updatePause();
    this.cleanup = () => { clearInterval(timer); observer.disconnect(); media.removeEventListener('change', onMotion); };
  }
  disconnectedCallback() { this.cleanup?.(); }
}
if (!customElements.get('app-showcase')) customElements.define('app-showcase', AppShowcase);
</script>
<style>
app-showcase{display:block;border:1px solid var(--line,#e5e7eb);border-radius:5px;background:var(--paper,#fff);overflow:hidden;margin-block:22px;color:var(--ink,#111827)}figure{margin:0}figure[hidden]{display:none}figure>a{position:relative;display:flex;align-items:center;justify-content:center;aspect-ratio:1.85;background:#111;overflow:hidden}img{display:block;width:100%;height:100%;object-fit:contain}.expand{position:absolute;right:8px;bottom:8px;border-radius:4px;background:#111827d9;color:white;padding:3px 7px;font-size:15px}figcaption{display:flex;flex-direction:column;gap:4px;padding:14px 16px;min-height:78px;border-top:1px solid var(--line,#e5e7eb)}figcaption strong{font-size:13px;font-weight:600}figcaption span{font-size:11px;line-height:1.6;color:var(--muted,#6b7280)}.controls{display:flex;align-items:center;gap:6px;padding:6px 10px;border-top:1px solid var(--line,#e5e7eb)}button{display:flex;align-items:center;justify-content:center;min-width:32px;min-height:36px;border:0;border-radius:4px;background:transparent;color:inherit;font:inherit;font-size:15px;cursor:pointer}button:hover{background:var(--pale,#eff6ff)}button:focus-visible{outline:2px solid #3b82f6;outline-offset:-2px}.dots{display:flex;align-items:center;gap:0}.dots button{min-width:28px}.dots span{display:block;width:6px;height:6px;border-radius:50%;background:var(--muted,#6b7280)}.dots [aria-pressed=true] span{background:#3b82f6;width:18px;border-radius:4px}.pause{margin-left:auto;font-size:13px}.counter{font-size:10px;color:var(--muted,#6b7280);min-width:32px;text-align:center}@media(max-width:500px){figcaption{min-height:86px}}
</style>
