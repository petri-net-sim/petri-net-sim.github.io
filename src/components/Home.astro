---
import sources from '../data/sources.json';
import Showcase from './Showcase.astro';
const { lang = 'en' } = Astro.props;
const uk = lang === 'uk';
const prefix = uk ? '/uk' : '';
const t = (en, ua) => uk ? ua : en;
const desktop = sources.desktop;
const command = `docker run -d --name petri-net-sim -p 127.0.0.1:6204:8000 -e APP_PUBLIC_URL=http://localhost:6204 -v petri-net-sim-data:/data ghcr.io/${sources.web.repository.split('/')[0]}/petri-net-sim-local:${sources.web.release || 'latest'}`;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Petri Net Simulation Portal</title>
  <meta name="description" content={t('System modeling and simulation with Petri nets. Download PetriObjModelPaint, run Petri Net Sim, and explore guides, APIs and Java libraries.', 'Моделювання та симуляція систем за допомогою мереж Петрі. Застосунки, навчальні матеріали, API та Java-бібліотеки.')} />
  <link rel="canonical" href={`https://petri-net-sim.github.io${prefix}/`} />
  <link rel="alternate" hreflang="en" href="https://petri-net-sim.github.io/" /><link rel="alternate" hreflang="uk" href="https://petri-net-sim.github.io/uk/" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:title" content="Petri Net Simulation Portal" /><meta property="og:type" content="website" />
  <meta property="og:description" content={t('Build a model. Run an experiment. Understand your system.', 'Побудуйте модель. Проведіть експеримент. Дослідіть систему.')} />
  <script is:inline>try { document.documentElement.dataset.theme = localStorage.getItem('portal-theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'); } catch {}</script>
</head>
<body>
  <a class="skip" href="#main">{t('Skip to content', 'До вмісту')}</a>
  <header><a class="brand" href={`${prefix}/`}><svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="9" cy="20" r="7"/><circle cx="9" cy="20" r="2" class="token"/><path d="M16 20h10m-4-4 4 4-4 4"/><rect x="28" y="9" width="5" height="22"/></svg><span>Petri Net<span class="brand-sub">Simulation Portal</span></span></a>
    <nav aria-label={t('Main navigation', 'Головна навігація')}><a href="#tools">{t('Applications', 'Застосунки')}</a><a href={`${prefix}/start/`}>{t('Documentation', 'Документація')}</a><a href={`${prefix}/learn/first-model/`}>{t('Learn', 'Навчання')}</a><a href={`${prefix}/integrations/`}>API</a></nav>
    <div class="utilities"><a class="language" href={uk ? '/' : '/uk/'} lang={uk ? 'en' : 'uk'}>{uk ? 'EN' : 'УКР'}</a><button id="theme" aria-label={t('Toggle color theme', 'Змінити тему')}>◐</button><a class="github" href="https://github.com/petri-net-sim" aria-label="GitHub"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03A9.58 9.58 0 0 1 12 6.83c.85 0 1.71.11 2.51.34 1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.84-2.33 4.69-4.56 4.94.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg></a></div>
  </header>
  <main id="main">
    <section class="hero wrap">
      <div class="hero-copy"><p class="eyebrow"><span></span> {t('TOOLS & KNOWLEDGE FOR SYSTEM MODELING', 'ІНСТРУМЕНТИ ТА ЗНАННЯ ДЛЯ МОДЕЛЮВАННЯ')}</p>
        <h1>{t('Model and simulate', 'Моделювання')}<br/>{t('systems with', 'та симуляція систем')}<br/><em>{t('Petri nets.', 'мережами Петрі.')}</em></h1>
        <p class="intro">{t('System modeling and simulation with Petri nets. Learning resources and documentation for PetriObjModelPaint and Petri Net Sim.', 'Моделювання та симуляція систем за допомогою мереж Петрі. Навчальні матеріали й документація PetriObjModelPaint та Petri Net Sim.')}</p>
        <div class="actions"><a class="button primary" href="#tools">{t('Get the applications', 'Обрати застосунок')} <span>↗</span></a><a class="text-link" href={`${prefix}/learn/first-model/`}>{t('Build your first model', 'Побудувати першу модель')} →</a></div>
      </div>
      <div class="hero-art"><div class="diagram-heading"><span>01 / {t('A SIMPLE SERVICE SYSTEM', 'ПРОСТА СИСТЕМА ОБСЛУГОВУВАННЯ')}</span><span class="status">{t('Illustrative model', 'Приклад моделі')}</span></div>
        <svg class="net" viewBox="0 0 580 400" role="img" aria-label={t('Petri net: arrivals enter a queue, service uses an available resource, completed jobs leave the system.', 'Мережа Петрі: заявки надходять у чергу, обслуговування займає ресурс, виконані заявки залишають систему.')}>
          <defs><marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 10 5 0 10Z" fill="currentColor"/></marker></defs>
          <g class="arcs" marker-end="url(#arrow)"><path d="M76 225H147"/><path d="M161 225H232"/><path d="M288 225H360"/><path d="M374 225H450"/><path d="M367 92V207"/><path d="M374 239C450 345 535 105 397 66"/></g>
          <g class="places"><circle cx="48" cy="225" r="27"/><circle cx="260" cy="225" r="27"/><circle cx="480" cy="225" r="27"/><circle cx="367" cy="65" r="27"/></g>
          <g class="transitions"><rect x="147" y="199" width="14" height="52" rx="2"/><rect x="360" y="199" width="14" height="52" rx="2"/></g>
          <g class="tokens"><circle cx="48" cy="225" r="5"/><circle cx="251" cy="219" r="5"/><circle cx="270" cy="219" r="5"/><circle cx="260" cy="235" r="5"/><circle cx="367" cy="65" r="5"/></g>
          <g class="labels"><text x="48" y="278">{t('Source', 'Джерело')}</text><text x="154" y="278">{t('Arrival', 'Надходження')}</text><text x="260" y="278">{t('Queue', 'Черга')}</text><text x="367" y="278">{t('Service', 'Обробка')}</text><text x="480" y="278">{t('Done', 'Виконано')}</text><text x="367" y="20">{t('Resource', 'Ресурс')}</text></g>
          <g class="timings"><text x="154" y="307">exp(2.0)</text><text x="367" y="307">exp(1.5)</text></g>
        </svg>
        <div class="legend"><span><i class="circle"></i>{t('Place', 'Позиція')}</span><span><i class="bar"></i>{t('Transition', 'Перехід')}</span><span><i class="dot"></i>{t('Token', 'Маркер')}</span></div>
        <div class="art-note">{t('Queues, resources, timing. One shared language for your system.', 'Черги, ресурси, час. Спільна мова для опису системи.')}</div>
      </div>
    </section>
    <div class="chapter wrap"><span>01</span><p>{t('CHOOSE YOUR WORKSPACE', 'ОБЕРІТЬ СЕРЕДОВИЩЕ')}</p><div></div><span>{t('Desktop & web', 'Десктоп і веб')}</span></div>
    <section id="tools" class="tools wrap">
      <article class="desktop product"><div class="product-top"><span class="tag">{t('DESKTOP APPLICATION', 'НАСТІЛЬНИЙ ЗАСТОСУНОК')}</span><span class="version">{desktop.release || 'Java 23+'}</span></div><h2>PetriObjModelPaint</h2><p>{t('Draw Petri nets, compose Petri-object models and run simulations. A desktop workspace for exploring how your system behaves.', 'Будуйте мережі Петрі, поєднуйте Петрі-об’єкти та запускайте симуляцію. Настільне середовище для дослідження поведінки систем.')}</p>
        <Showcase app="pomp" lang={lang} />
        <div class="download-label">{t('DOWNLOAD FOR YOUR PLATFORM', 'ЗАВАНТАЖИТИ ДЛЯ СВОЄЇ ПЛАТФОРМИ')}</div>
        <div class="downloads">{['windows', 'linux', 'macos'].map(platform => { const asset = desktop.downloads.find(a => a.platform === platform); return <a class="download" href={asset?.url || desktop.releaseUrl}>{platform === 'macos' ? 'macOS' : platform === 'windows' ? 'Windows' : 'Linux'} <span>↓</span></a>; })}</div>
        <p class="requirement">{t('Requires Java 23 or newer.', 'Потрібна Java 23 або новіша.')} <a href={`${prefix}/desktop/docs/desktop-ui/`}>{t('Installation guide', 'Встановлення')} →</a></p>
        <a class="product-link" href={`${prefix}/desktop/overview/`}>{t('Explore the desktop documentation', 'Документація настільного застосунку')} →</a>
      </article>
      <article class="web product"><div class="product-top"><span class="tag">{t('WEB APPLICATION', 'ВЕБЗАСТОСУНОК')}</span><span class="version">{sources.web.release || 'Docker'}</span></div><h2>Petri Net Sim</h2><p>{t('Describe a system in natural language and generate a Petri net with an LLM. Refine the model in the browser, simulate it and inspect the results.', 'Опишіть систему звичайною мовою та згенеруйте мережу Петрі за допомогою LLM. Редагуйте модель у браузері, запускайте симуляцію й аналізуйте результати.')}</p>
        <Showcase app="pns" lang={lang} />
        <div class="download-label">{t('RUN LOCALLY WITH DOCKER', 'ЗАПУСТИТИ ЛОКАЛЬНО ЧЕРЕЗ DOCKER')}</div><div class="terminal"><div><span>terminal</span><button class="copy" data-copy={command}>{t('Copy command', 'Копіювати')}</button></div><pre><code>{command}</code></pre></div>
        <p class="requirement">{t('Then open', 'Потім відкрийте')} <a href="http://localhost:6204">localhost:6204</a>. {t('Bring your own LLM key. Image: linux/amd64.', 'Додайте власний ключ LLM. Образ: linux/amd64.')}</p>
        <a class="product-link" href={`${prefix}/web/docs/running/`}>{t('Setup, source builds and documentation', 'Налаштування, збірка та документація')} →</a>
      </article>
    </section>
    <section class="library-band"><div class="wrap library-inner"><div><p class="eyebrow">02 / {t('BUILD ON THE ENGINE', 'ВИКОРИСТОВУЙТЕ РУШІЙ')}</p><h2>{t('Your code. The same models.', 'Ваш код. Ті самі моделі.')}</h2><p>{t('Use the simulation engine in a Java application, connect through HTTP, or make modeling tools available to an AI assistant through MCP.', 'Підключіть рушій симуляції до Java-застосунку, використовуйте HTTP API або надайте AI-асистенту інструменти моделювання через MCP.')}</p><a class="button primary" href={`${prefix}/integrations/`}>{t('Explore integrations', 'Переглянути інтеграції')} ↗</a></div><div class="library-list">{[['petri-math',t('Simulation engine', 'Рушій симуляції')],['petri-api',t('Interfaces and contracts', 'Інтерфейси та контракти')],['petri-model',t('Graph models and PNML', 'Графові моделі та PNML')]].map(([name, description]) => <a href={`${prefix}/desktop/docs/java-libraries/`}><code>{name}</code><span>{description}</span><span>↗</span></a>)}<a href={`${prefix}/integrations/`}><code>HTTP / MCP</code><span>{t('Applications and agents', 'Застосунки та агенти')}</span><span>↗</span></a></div></div></section>
    <section class="learning wrap"><div class="chapter"><span>03</span><p>{t('UNDERSTAND THE MODEL', 'ЗРОЗУМІЙТЕ МОДЕЛЬ')}</p><div></div></div><div class="learning-heading"><h2>{t('Start small. Model further.', 'Почніть із простого.')}</h2><p>{t('Learn the concepts, find a useful pattern and connect it to a real experiment.', 'Вивчіть основи, оберіть потрібний патерн і проведіть експеримент.')}</p></div><div class="resources">{[
      [t('01 / THE BASICS','01 / ОСНОВИ'),t('Your first Petri net','Ваша перша мережа Петрі'),t('Places, transitions and tokens, explained through a queue and a service station.','Позиції, переходи та маркери на прикладі черги й обслуговування.'),'learn/first-model'],
      [t('02 / MODELING','02 / МОДЕЛЮВАННЯ'),t('Reusable modeling patterns','Патерни моделювання'),t('Arrivals, queues, resources, routing and composition. Read the shared modeling catalog.','Надходження, черги, ресурси, маршрутизація та композиція. Спільний каталог патернів.'),'modeling/petri_modeling_skills/skills/petri-patterns/references/pattern-catalog'],
      [t('03 / INTERCHANGE','03 / ОБМІН'),t('One model, both applications','Одна модель, два застосунки'),t('Understand Petri-object composition and exchange models using PNML.','Дізнайтеся про Петрі-об’єктні моделі та обмін через PNML.'),'desktop/docs/petri-object-models']
    ].map(([label,title,description,href]) => <a class="resource" href={`${prefix}/${href}/`}><span class="eyebrow">{label}</span><h3>{title}</h3><p>{description}</p><span class="resource-arrow">↗</span></a>)}</div></section>
    <section class="docs-band wrap"><div><h2>{t('Looking for a specific detail?', 'Шукаєте конкретну відповідь?')}</h2><p>{t('Browse the full guides for installation, simulation, statistics, deployment and integrations.', 'Перегляньте посібники зі встановлення, симуляції, статистики, розгортання та інтеграцій.')}</p></div><a class="button" href={`${prefix}/start/`}>{t('Open documentation', 'Відкрити документацію')} →</a></section>
  </main>
  <footer class="wrap"><div><strong>Petri Net Simulation Portal</strong><p>{t('Tools and knowledge for modeling systems with Petri nets.', 'Інструменти та знання для моделювання систем мережами Петрі.')}</p></div><div><a href={`${prefix}/about/`}>{t('About, authors & licenses', 'Про портал, автори та ліцензії')}</a><a href="https://github.com/petri-net-sim/petri-net-sim.github.io">{t('Source & contributions', 'Код і внески')}</a></div></footer>
  <script>
    document.querySelector('#theme')?.addEventListener('click', () => { const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'; document.documentElement.dataset.theme = theme; try { localStorage.setItem('portal-theme', theme); } catch {} });
    document.querySelectorAll<HTMLButtonElement>('.copy').forEach(button => button.addEventListener('click', async () => { const label = button.textContent; try { await navigator.clipboard.writeText(button.dataset.copy || ''); button.textContent = document.documentElement.lang === 'uk' ? 'Скопійовано' : 'Copied'; setTimeout(() => button.textContent = label, 2000); } catch { button.textContent = document.documentElement.lang === 'uk' ? 'Виділіть і скопіюйте команду' : 'Select and copy the command'; } }));
  </script>
</body></html>
<style is:global>
  *{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px;--bg:#f9fafb;--paper:#fff;--ink:#111827;--muted:#6b7280;--line:#e5e7eb;--accent:#2563eb;--pale:#eff6ff;--band:#f3f4f6;color-scheme:light}html[data-theme=dark]{--bg:#0f0f0f;--paper:#1a1a1a;--ink:#f9fafb;--muted:#9ca3af;--line:#2e2e2e;--accent:#3b82f6;--pale:#172554;--band:#171717;color-scheme:dark}body{margin:0;background:var(--bg);color:var(--ink);font-family:'Segoe UI',system-ui,sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}button{font:inherit;cursor:pointer}a:focus-visible,button:focus-visible{outline:3px solid var(--accent);outline-offset:5px}a:hover{color:var(--accent)}.wrap{max-width:1280px;margin-inline:auto;padding-inline:44px}.skip{position:absolute;left:16px;top:-80px;z-index:10;background:var(--paper);padding:12px}.skip:focus{top:12px}header{height:96px;max-width:1368px;padding:0 44px;display:flex;align-items:center;gap:32px;margin:auto;border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:10px;font-size:16px;font-weight:700;line-height:1.2;letter-spacing:-.4px}.brand svg{width:39px;height:39px;fill:none;stroke:var(--accent);stroke-width:2}.brand .token{fill:var(--accent);stroke:none}.brand-sub{display:block;font-size:12px;letter-spacing:.3px;font-weight:500;margin-top:3px}nav{display:flex;gap:28px;margin-left:auto;font-size:14px}.utilities{display:flex;gap:18px;align-items:center;border-left:1px solid var(--line);padding-left:24px}.utilities button{border:0;background:none;color:var(--ink);font-size:24px;padding:0}.language{font-size:12px;font-weight:700}.github svg{height:21px;width:21px}.hero{display:grid;grid-template-columns:1.05fr 1fr;gap:48px;align-items:center;padding-block:76px 84px}.eyebrow{font-size:10px;letter-spacing:1.6px;font-weight:700;line-height:1.7;color:var(--muted);margin:0 0 22px}.eyebrow>span{display:inline-block;width:7px;height:7px;background:var(--accent);border-radius:50%;margin-right:7px}h1{font-size:clamp(44px,4.7vw,64px);letter-spacing:-2.9px;line-height:1.08;font-weight:650;margin:0}h1 em{font-style:normal;color:var(--accent)}.intro{font-size:16px;line-height:1.75;color:var(--muted);max-width:470px;margin:25px 0 30px}.actions{display:flex;gap:25px;align-items:center;flex-wrap:wrap}.button{display:inline-flex;gap:25px;align-items:center;padding:14px 20px;border:1px solid var(--line);border-radius:5px;font-size:13px;font-weight:600;white-space:nowrap}.button.primary{background:#2563eb;border-color:#2563eb;color:#ffffff}.button.primary:hover{filter:brightness(1.1)}.text-link{font-size:12px;font-weight:600}.hero-art{border:1px solid var(--line);background-color:var(--paper);background-image:radial-gradient(var(--line) .8px,transparent .8px);background-size:18px 18px;border-radius:8px;overflow:hidden;transform:rotate(-1deg);box-shadow:0 15px 50px #11182710}.diagram-heading{display:flex;justify-content:space-between;padding:20px 20px 0;font-size:8px;letter-spacing:1px;color:var(--muted);gap:10px}.status{background:var(--pale);padding:4px 7px;border-radius:3px;letter-spacing:0;color:var(--accent)}.net{width:100%;padding:20px 15px 0;color:var(--ink);overflow:visible}.arcs{stroke:currentColor;stroke-width:1.8;fill:none}.places{stroke:var(--accent);stroke-width:2;fill:var(--paper)}.transitions{fill:var(--accent)}.tokens{fill:var(--ink)}.labels{font-size:12px;fill:var(--ink);text-anchor:middle}.timings{font-family:monospace;font-size:10px;fill:var(--muted);text-anchor:middle}.legend{display:flex;justify-content:center;gap:24px;font-size:10px;color:var(--muted);padding-bottom:23px}.legend span{display:flex;align-items:center;gap:7px}.legend i{display:block}.circle{width:12px;height:12px;border:1.5px solid var(--accent);border-radius:50%}.bar{width:4px;height:13px;background:var(--accent)}.dot{width:5px;height:5px;background:var(--ink);border-radius:50%}.art-note{border-top:1px solid var(--line);font-size:10px;color:var(--muted);padding:16px 20px;background:var(