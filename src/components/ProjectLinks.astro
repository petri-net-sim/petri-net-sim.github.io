---
const { repository, releaseUrl, lang = 'en' } = Astro.props;
const uk = lang === 'uk';
---
<div class="project-links"><a class="repository" href={`https://github.com/${repository}`}><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m8 7-5 5 5 5m8-10 5 5-5 5M14 4l-4 16"/></svg>{uk ? 'Репозиторій на GitHub' : 'GitHub repository'} <span aria-hidden="true">↗</span></a>{releaseUrl && <a class="releases" href={releaseUrl}>{uk ? 'Випуски та завантаження' : 'Releases and downloads'} <span aria-hidden="true">↗</span></a>}</div>
<style>
.project-links{display:flex;gap:10px 16px;align-items:center;flex-wrap:wrap;margin:14px 0 20px;font-family:'Segoe UI',system-ui,sans-serif}.project-links a{display:inline-flex;align-items:center;gap:7px;line-height:1.5;font-size:11px;font-weight:600;text-decoration:none;color:var(--accent,var(--sl-color-text-accent,#2563eb))}.project-links .repository{padding:8px 11px;border:1px solid var(--line,var(--sl-color-gray-5,#e5e7eb));border-radius:4px;background:var(--bg,var(--sl-color-bg,#f9fafb))}.project-links a:hover{text-decoration:underline}.project-links .repository:hover{border-color:#3b82f6}.project-links a:focus-visible{outline:2px solid #3b82f6;outline-offset:3px}.project-links .releases{font-weight:500;font-size:10px}
</style>
