---
import { readFileSync } from 'node:fs';
import path from 'node:path';
export function getStaticPaths() {
  return ['desktop', 'web'].map(project => ({ params: { project }, props: { schema: JSON.parse(readFileSync(path.resolve('public/reference', project, 'openapi.json'), 'utf8')) } }));
}
const { schema } = Astro.props;
const project = Astro.params.project;
const name = project === 'desktop' ? 'petri-server' : 'Petri Net Sim';
const methods = ['get', 'post', 'put', 'patch', 'delete', 'head', 'options'];
const operations = Object.entries(schema.paths).flatMap(([url, value]) => Object.entries(value as Record<string, any>).filter(([method]) => methods.includes(method)).map(([method, operation]) => ({ url, method, ...operation })));
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{name} API | Petri Net Simulation Portal</title><meta name="description" content={`Generated OpenAPI reference for ${name}. Endpoints, request bodies, response schemas and authentication.`}/><link rel="icon" href="/favicon.svg"/><link rel="canonical" href={`https://petri-net-sim.github.io/reference/${project}/`}/></head><body>
<header><a href="/">← Petri Net Simulation Portal</a><a href="/integrations/">All integrations</a></header><main>
<p class="eyebrow">GENERATED API REFERENCE</p><h1>{name}</h1><p class="intro">Version {schema.info.version}. This reference is generated from the application code during site publication.</p>
<div class="links"><a href={`/reference/${project}/openapi.json`}>Download OpenAPI JSON ↓</a><a href={project === 'desktop' ? '/desktop/docs/petri-server-integration/' : '/web/docs/integrations/'}>Integration guide →</a></div>
<label for="filter">Find an endpoint</label><input id="filter" type="search" placeholder="Search path, method or description"/><p id="count" aria-live="polite">{operations.length} operations</p>
<section aria-label="API operations">{operations.map(operation => <details class="operation" data-search={`${operation.method} ${operation.url} ${operation.summary || ''} ${(operation.tags || []).join(' ')}`.toLowerCase()}><summary><span class={`method ${operation.method}`}>{operation.method.toUpperCase()}</span><code>{operation.url}</code><span class="summary">{operation.summary}</span></summary><div class="content">
{operation.description && <p>{operation.description}</p>}
{operation.security && <p><strong>Authentication:</strong> {JSON.stringify(operation.security)}</p>}
{operation.parameters?.length > 0 && <><h3>Parameters</h3><pre><code>{JSON.stringify(operation.parameters, null, 2)}</code></pre></>}
{operation.requestBody && <><h3>Request body</h3><pre><code>{JSON.stringify(operation.requestBody, null, 2)}</code></pre></>}
<h3>Responses</h3><pre><code>{JSON.stringify(operation.responses, null, 2)}</code></pre></div></details>)}</section>
<details class="schemas"><summary>Shared schemas and security schemes</summary><pre><code>{JSON.stringify(schema.components, null, 2)}</code></pre></details>
</main><footer><a href="/about/">Sources, authors and licenses</a></footer>
<script>const filter = document.querySelector<HTMLInputElement>('#filter'); const operations = [...document.querySelectorAll<HTMLElement>('.operation')]; filter?.addEventListener('input', () => { const query = filter.value.toLowerCase().trim(); let count = 0; for (const operation of operations) { operation.hidden = !operation.dataset.search?.includes(query); if (!operation.hidden) count++; } document.querySelector('#count')!.textContent = `${count} operations`; });</script>
</body></html>
<style> :global(*){box-sizing:border-box}:global(body){margin:0;background:#f7f8f4;color:#192c29;font-family:'Segoe UI',system-ui,sans-serif}header,main,footer{max-width:1100px;margin:auto;padding:28px}header{display:flex;justify-content:space-between;border-bottom:1px solid #dce2dc;font-size:13px}a{color:#087f6c;text-decoration:none}a:hover{text-decoration:underline}.eyebrow{font-size:10px;letter-spacing:1.6px;color:#5e6c67;margin-top:30px}h1{font-size:44px;letter-spacing:-1.5px;margin:14px 0}.intro{color:#5e6c67;line-height:1.8}.links{display:flex;gap:24px;flex-wrap:wrap;font-size:13px;margin:25px 0 40px}label{display:block;font-size:13px;margin-bottom:8px}input{width:100%;padding:14px;border:1px solid #b3c9bd;border-radius:5px;font:inherit;background:white}input:focus-visible{outline:2px solid #087f6c;outline-offset:3px}#count{font-size:12px;color:#5e6c67}.operation{background:white;border:1px solid #dce2dc;border-radius:5px;margin-block:10px}.operation summary{padding:17px;cursor:pointer;display:flex;align-items:center;gap:16px;font-size:12px;flex-wrap:wrap}.method{font-family:monospace;background:#e5f4ec;color:#087f6c;border-radius:3px;min-width:62px;text-align:center;padding:6px}.method.post{background:#e9effa;color:#385f9b}.method.delete{background:#f9e9e5;color:#9b4838}.summary{color:#5e6c67}.content{padding:0 20px 20px;font-size:13px;line-height:1.7;border-top:1px solid #dce2dc}.content p{white-space:pre-wrap}pre{overflow:auto;background:#edf1ea;padding:18px;font-size:11px;line-height:1.7;border-radius:4px}.schemas{margin-block:30px}.schemas summary{cursor:pointer;font-size:15px}footer{border-top:1px solid #dce2dc;font-size:12px}@media(max-width:600px){header,main,footer{padding:20px}.operation summary{gap:8px}.operation code{overflow-wrap:anywhere}.summary{width:100%}h1{font-size:35px}}</style>
